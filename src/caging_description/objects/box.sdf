<?xml version="1.0" ?>
<!--
  Box (paper Fig. 10, object 1). Size 0.2 x 0.2 x 0.2 m.
  Movable, light (mass 0.1 kg) and with low friction against the floor (mu = 0.2),
  so the robots can push and carry it. Spawned by caging_bringup/two_robots.launch.py
  with the model name "object".

  Inertia: solid cube, I = m (a^2 + a^2) / 12.
  The origin is on the floor at the center of the base; the center of mass is at z = 0.1 m.
-->
<sdf version="1.11">
  <model name="box">
    <link name="link">
      <inertial>
        <pose>0 0 0.1 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>6.667e-4</ixx> <iyy>6.667e-4</iyy> <izz>6.667e-4</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>    <!-- low friction (Gazebo uses the smaller mu of the two surfaces) -->
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <!--
      Ground truth of the object ("virtual Vicon", like the robots in Step 3):
        /model/object/odometry -> bridged to /object/ground_truth/odom
        /model/object/pose     -> bridged to /tf as  world -> object
      dimensions = 3: the object could tilt if it is pushed badly, report the full pose.
    -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>object</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
