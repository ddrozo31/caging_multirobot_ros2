<?xml version="1.0" ?>
<!--
  Hemisphere (paper Fig. 10, object 2). Radius 0.1 m, flat face down. Mesh: meshes/hemisphere.stl.
  Movable, light (mass 0.1 kg) and with low friction against the floor (mu = 0.2),
  so the robots can push and carry it. Spawned by caging_bringup/two_robots.launch.py
  with the model name "object".

  Inertia: solid hemisphere about its center of mass, Ixx = Iyy = 83/320 m r^2, Izz = 2/5 m r^2.
  The origin is on the floor at the center of the base; the center of mass is at z = 0.0375 m.
-->
<sdf version="1.11">
  <model name="hemisphere">
    <link name="link">
      <inertial>
        <pose>0 0 0.0375 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>2.594e-4</ixx> <iyy>2.594e-4</iyy> <izz>4.0e-4</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://caging_description/meshes/hemisphere.stl</uri></mesh></geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>    <!-- low friction (Gazebo uses the smaller mu of the two surfaces) -->
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://caging_description/meshes/hemisphere.stl</uri></mesh></geometry>
        <material>
          <ambient>0.2 0.3 0.8 1</ambient>
          <diffuse>0.2 0.3 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!--
      Ground truth of the object ("virtual Vicon", like the robots in Step 3):
        /model/object/odometry -> bridged to /object/ground_truth/odom
        /model/object/pose     -> bridged to /tf as  world -> object
      dimensions = 3: the object could tilt if it is pushed badly, report the full pose.
    -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>object</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
