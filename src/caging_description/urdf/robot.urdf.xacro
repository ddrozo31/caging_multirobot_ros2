<?xml version="1.0"?>
<!--
  Top-level robot file: it only includes the other pieces.

  To see the final URDF that xacro generates, run:
    xacro $(ros2 pkg prefix caging_description)/share/caging_description/urdf/robot.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rosmaster_x3">

    <xacro:include filename="properties.xacro"/>   <!-- colors (materials) -->
    <xacro:include filename="robot_core.xacro"/>   <!-- links and joints of the robot -->
    <xacro:include filename="ros2_control.xacro"/> <!-- joint interfaces for ros2_control -->
    <xacro:include filename="gazebo.xacro"/>       <!-- Gazebo-only settings (friction, plugins) -->

</robot>
