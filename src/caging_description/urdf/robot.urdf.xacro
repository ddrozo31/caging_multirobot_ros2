<?xml version="1.0"?>
<!--
  Top-level robot file: it only includes the other pieces.

  To see the final URDF that xacro generates, run:
    xacro $(ros2 pkg prefix caging_description)/share/caging_description/urdf/robot.urdf.xacro
    xacro ... robot.urdf.xacro namespace:=leader color:=red     (one of several robots, Step 5)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rosmaster_x3">

    <!--
      namespace (Step 5): name of the robot when there are several ("leader", "follower").
      Empty (default) = only one robot, exactly as in Steps 1-4.
      Link and joint names do NOT change: robot_state_publisher adds the prefix
      ("leader/base_link") with its frame_prefix parameter. Only the Gazebo
      plugins need the name (see gazebo.xacro).
    -->
    <xacro:arg name="namespace" default=""/>
    <xacro:property name="namespace" value="$(arg namespace)"/>

    <!--
      color (Step 5): color of the chassis, one of the materials of properties.xacro
      (white, red, blue, ...). The leader is red and the follower blue, so they can be
      told apart in Gazebo and RViz.
    -->
    <xacro:arg name="color" default="white"/>
    <xacro:property name="body_color" value="$(arg color)"/>

    <xacro:include filename="properties.xacro"/>   <!-- colors (materials) -->
    <xacro:include filename="robot_core.xacro"/>   <!-- links and joints of the robot -->
    <xacro:include filename="ros2_control.xacro"/> <!-- joint interfaces for ros2_control -->
    <xacro:include filename="gazebo.xacro"/>       <!-- Gazebo-only settings (friction, plugins) -->

</robot>
