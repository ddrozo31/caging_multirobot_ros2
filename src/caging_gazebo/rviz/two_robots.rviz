# RViz for Step 5: two robots (leader, follower) and the object.
# Robot models are placed by the ground truth ("Vicon"); wheel odometry = red/pink arrows.
# Tools (top toolbar): the FIRST "2D Goal Pose" button sends goals to the LEADER
# (/leader/goal_pose), the SECOND one to the FOLLOWER (/follower/goal_pose).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m cells)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Leader model (placed by the ground truth)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /leader/robot_description
      TF Prefix: leader          # the URDF says "base_link"; in TF it is "leader/base_link"
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Follower model (placed by the ground truth)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /follower/robot_description
      TF Prefix: follower          # the URDF says "base_link"; in TF it is "follower/base_link"
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frames:
        All Enabled: false
        world:
          Value: true
        object:
          Value: true
        leader/odom:
          Value: true
        leader/base_link:
          Value: true
        follower/odom:
          Value: true
        follower/base_link:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Leader ground truth (green)
      Enabled: true
      Topic:
        Value: /leader/ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 0; 200; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Follower ground truth (blue)
      Enabled: true
      Topic:
        Value: /follower/ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 0; 120; 255
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Object ground truth (orange)
      Enabled: true
      Topic:
        Value: /object/ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 140; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Leader wheel odometry (red, example only)
      Enabled: true
      Topic:
        Value: /leader/mecanum_controller/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 230; 0; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Follower wheel odometry (pink, example only)
      Enabled: true
      Topic:
        Value: /follower/mecanum_controller/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 120; 160
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Leader goal
      Enabled: true
      Topic:
        Value: /leader/goal_pose
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 220; 0
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Follower goal
      Enabled: true
      Topic:
        Value: /follower/goal_pose
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 0; 255
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Object (drawn by object_marker)
      Enabled: true
      Topic:
        Value: /object/marker
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal   # 1st "2D Goal Pose" = leader
      Topic:
        Value: /leader/goal_pose
    - Class: rviz_default_plugins/SetGoal   # 2nd "2D Goal Pose" = follower
      Topic:
        Value: /follower/goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: -1.2
        Z: 0
      Pitch: 1.2
      Yaw: -1.57
      Name: Current View
      Target Frame: world
      Value: Orbit (rviz)
Window Geometry:
  Height: 800
  Width: 1200
