Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m cells)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (placed by the wheel odometry)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        world:
          Value: true
        odom:
          Value: true
        base_link:
          Value: true
        ground_truth:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (green)
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 0; 200; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry (red)
      Enabled: true
      Topic:
        Value: /mecanum_controller/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 230; 0; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: -1.57
      Name: Current View
      Target Frame: world
      Value: Orbit (rviz)
Window Geometry:
  Height: 800
  Width: 1200
