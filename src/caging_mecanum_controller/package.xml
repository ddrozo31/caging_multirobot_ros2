<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caging_mecanum_controller</name>
  <version>0.0.1</version>
  <description>ros2_control controller for a 4-wheel mecanum robot (Eq. 1 of Tejada et al. 2025).</description>
  <maintainer email="david.rozo31@eia.edu.co">David Rozo-Osorio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- "depend" = needed to build AND to run -->
  <depend>controller_interface</depend>   <!-- base class of every ros2_control controller -->
  <depend>hardware_interface</depend>     <!-- command/state interfaces of the joints -->
  <depend>pluginlib</depend>              <!-- loads our controller as a plugin -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>         <!-- thread-safe box and real-time publisher -->
  <depend>geometry_msgs</depend>          <!-- Twist message -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
